# Copy to .env. The setup script generates a database password for local use.
POSTGRES_PASSWORD=change-this-local-password
APP_PORT=9042
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:9042,https://leetbug.nevatal.id,http://leetbug.nevatal.id
ALLOWED_HOSTS=leetbug.nevatal.id,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://leetbug.nevatal.id,http://leetbug.nevatal.id
SITE_URL=https://leetbug.nevatal.id
COOKIE_SECURE=false

# Optional demo account. Keep disabled on a public deployment.
SEED_DEMO_USER=false
DEMO_PASSWORD=DebugBetter2026!

# disabled | openrouter | ollama
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=qwen2.5-coder:7b
# Blank selects the provider default endpoint.
AI_BASE_URL=
# Set to ollama to include the local model service in ordinary Compose starts.
# COMPOSE_PROFILES=ollama

# Optional semantic embeddings via an Ollama-compatible /v1 endpoint.
# Blank uses deterministic lexical embeddings in Chroma, without model downloads.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Admin account. The user who registers with this email gets admin access.
ADMIN_EMAIL=
